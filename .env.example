# Optional for local Docker; DATABASE_URL is commonly provided by hosted PostgreSQL services
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=knowledge_repo
DB_USER=kb
DB_PASSWORD=replace-with-a-long-random-password
DB_SSL=false
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
# Optional: enables the public, rate-limited repository assistant.
# Keep this key private and set a usage budget in the OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
